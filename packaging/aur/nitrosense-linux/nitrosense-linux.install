# The root-only parts of the install that can't ship as files.

# The CPU's rated maximum clock (SMBIOS type 4, max speed at offset 0x14) for the Home gauges; only root can read it.
_nitrosense_cpu_max() {
  local mhz
  mhz=$(od -An -tu2 -j20 -N2 /sys/firmware/dmi/entries/4-0/raw 2>/dev/null | tr -d ' ')
  if [ -n "$mhz" ] && [ "$mhz" -gt 0 ]; then
    mkdir -p /etc/nitrosense && echo "$mhz" >/etc/nitrosense/cpu_max_mhz
  fi
}

# Give the linuwu_sense group the controls now rather than at the next boot. pacman's sysusers hook only runs
# after this script, so the group is created here first.
_nitrosense_permissions() {
  systemd-sysusers /usr/lib/sysusers.d/nitrosense-linux.conf
  udevadm control --reload
  udevadm trigger --action=bind /sys/devices/platform/acer-wmi
  udevadm trigger --subsystem-match=hidraw --action=add
  if [ -d /sys/module/linuwu_sense ]; then udevadm trigger --action=add /sys/module/linuwu_sense; fi
}

post_install() {
  _nitrosense_cpu_max
  _nitrosense_permissions >/dev/null 2>&1
  cat <<'EOF'
==> NitroSense: two more steps for each user
  1. Join the linuwu_sense group, then log out and back in:
       sudo usermod -aG linuwu_sense "$USER"
  2. Bind the NitroSense key to the nitrosense command:
       Hyprland (hyprland.conf):      bind = , XF86Presentation, exec, nitrosense
       Omarchy (hypr/bindings.lua):   o.bind("XF86Presentation", "NitroSense", { launch = "nitrosense" })
       GNOME: Settings > Keyboard > Custom Shortcuts
     KDE Plasma and X11 sessions can't bind this key.
EOF
}

post_upgrade() {
  _nitrosense_cpu_max
  _nitrosense_permissions >/dev/null 2>&1
  return 0
}

post_remove() {
  rm -f /etc/nitrosense/cpu_max_mhz
  rmdir /etc/nitrosense 2>/dev/null
  return 0
}
