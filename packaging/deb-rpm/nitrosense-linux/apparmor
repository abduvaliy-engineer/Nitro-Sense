# NitroSense for Linux's Electron may create user namespaces, which Chromium's sandbox needs. Ubuntu 24.04 and newer
# allow that only for programs with a profile like this one; it confines nothing else.
abi <abi/4.0>,
include <tunables/global>

profile nitrosense-linux /usr/lib/nitrosense-linux/electron/electron flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/nitrosense-linux>
}
