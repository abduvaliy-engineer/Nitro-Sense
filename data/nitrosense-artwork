#!/usr/bin/env bash
# NitroSense for Linux: Acer's NitroSense artwork, taken from Acer's own NitroSense package and checked file by file
# against data/acer-assets.tsv (install.sh uses the same functions).
#   sudo nitrosense-artwork          NitroSense on a mounted Windows drive, else Acer's package from the Microsoft
#                                    Store (about 340 MB) for whatever is still missing
#   sudo nitrosense-artwork SOURCE   NitroSense's app.asar, its WindowsApps folder or a .msix/.msixbundle
# The .deb and .rpm packages run it when they're installed; NITROSENSE_ASSETS=SOURCE works like SOURCE.
# Sourced by install.sh, it only defines the functions, with NS_ROOT set to the checkout.

NS_ROOT=${NS_ROOT:-/usr/lib/nitrosense-linux}  # holds tools/ and data/acer-assets.tsv
NS_ARTWORK=${NS_ARTWORK:-/var/lib/nitrosense-linux/acer}

declare -F say >/dev/null || say() { printf '\033[1;38;5;208m==>\033[0m %s\n' "$*"; }

# Prints the first NitroSense package folder under the given mount points, if any.
artwork_find() {
  local dir asar
  for dir in "$@"; do
    for asar in "$dir"/Program\ Files/WindowsApps/*NitroSense*/app/resources/app.asar; do
      [ -f "$asar" ] && { echo "${asar%/app/resources/app.asar}"; return 0; }
    done
  done
  return 0
}

# Whether the folder $1 holds every file the manifest lists.
artwork_complete() {
  local target
  while IFS=$'\t' read -r target _; do
    [[ -z $target || $target == \#* ]] && continue
    [ -f "$1/$target" ] || return 1
  done <"$NS_ROOT/data/acer-assets.tsv"
}

# Copies the artwork out of the NitroSense package $1 into the folder $2, checking every file.
artwork_extract() {
  python3 -I "$NS_ROOT/tools/extract-acer-assets.py" "$1" "$NS_ROOT/data/acer-assets.tsv" "$2"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  set -euo pipefail
  case "${1:-}" in
    -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  esac
  [ "$(id -u)" -eq 0 ] || { echo "nitrosense-artwork needs root: sudo nitrosense-artwork" >&2; exit 1; }
  from=${1:-${NITROSENSE_ASSETS:-}}
  mkdir -p "$NS_ARTWORK"
  if [ -n "$from" ]; then
    say "Copying NitroSense artwork from $from"
    artwork_extract "$from" "$NS_ARTWORK"
    exit 0
  fi
  # NitroSense on Windows is the newest version; whatever it doesn't provide comes from the Store package.
  windows=$(artwork_find /run/media/*/* /media/*/* /mnt /mnt/*)
  if [ -n "$windows" ]; then
    say "Copying NitroSense artwork from Windows"
    artwork_extract "$windows" "$NS_ARTWORK" >/dev/null || true
  fi
  if artwork_complete "$NS_ARTWORK"; then
    say "NitroSense artwork is in place"
    exit 0
  fi
  say "Downloading Acer's NitroSense from the Microsoft Store for its artwork (about 340 MB)"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  python3 -I "$NS_ROOT/tools/fetch-nitrosense.py" "$tmp/NitroSense.msix"
  artwork_extract "$tmp/NitroSense.msix" "$NS_ARTWORK"
fi
